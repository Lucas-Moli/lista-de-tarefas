{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "To-Do List",
  "version": "1.0.0",
  "identifier": "com.example.todo-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "To-Do List",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
